{
    "manifest_version": 3,
    "name": "Digestube",
    "description": "A Chrome extension that summarizes YouTube videos on demand — click the extension while watching a video, and get back a short, readable digest of what it's actually about.",
    "version": "2.1",

    "permissions": ["activeTab"],
    "host_permissions": ["http://127.0.0.1:5000/*"],

    "action": {
        "default_title": "Digestube",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        },
        "default_popup": "popup.html"
    },

    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    }
}